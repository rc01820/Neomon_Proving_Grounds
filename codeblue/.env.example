# ──────────────────────────────────────────────
# CodeBlue — Neomon Proving Grounds
# Customer configuration
# ──────────────────────────────────────────────

# Application
APP_NAME=codeblue
APP_PORT=8002

# Display (shown in the UI header)
# APP_TITLE=CodeBlue
# APP_SUBTITLE=Healthcare Operations

# Datadog integration
DD_SERVICE=codeblue
DD_ENV=proving-grounds
# DD_AGENT_HOST=datadog-agent
# DD_TRACE_ENABLED=true
# DD_LOGS_INJECTION=true

# Logging
LOG_LEVEL=INFO

# Fault state persistence
FAULT_STATE_FILE=/app/data/faults.json

# Customer branding (optional)
# CUSTOMER_NAME=
# CUSTOMER_LOGO_URL=
